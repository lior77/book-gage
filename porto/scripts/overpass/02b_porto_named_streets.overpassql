/* ============================================================================
   2ב · רחובות וכיכרות ששמם זהה לשם שכונה
   ----------------------------------------------------------------------------
   שומרים בשם  porto_streets.geojson
   חלק מהשכונות קיימות ב-OSM רק כשם של רחוב (קושטה קברל, למשל). הסינון על
   highway מאונדקס, ולכן ה-regex רץ על קבוצה קטנה בלבד ולא על כל העירייה.
   ========================================================================= */

[out:json][timeout:120];

area(3603372453)->.porto;

way(area.porto)["highway"]["name"~"Costa Cabral|Carvalhido|Heroísmo|Matadouro|Salgueiros|Ourigo|Foz Velha",i];

out center;
