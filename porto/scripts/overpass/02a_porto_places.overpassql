/* ============================================================================
   2א · שכונות וייעודי קרקע בעיריית פורטו
   ----------------------------------------------------------------------------
   שומרים בשם  porto_places.geojson
   קלה ומהירה: שני הסינונים הם על מפתח מאונדקס (place, landuse), כך ש-Overpass
   לא סורק כל אובייקט בעירייה. זו הגרסה המפוצלת של השאילתה שנפלה ב-timeout.
   ========================================================================= */

[out:json][timeout:120];

area(3603372453)->.porto;

(
  nwr(area.porto)["place"]["name"];
  nwr(area.porto)["landuse"~"^(residential|commercial|industrial|retail)$"]["name"];
);

out center;
