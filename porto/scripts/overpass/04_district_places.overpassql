/* ============================================================================
   4 · היישובים והשכונות בכל 18 העיריות
   ----------------------------------------------------------------------------
   מריצים ב-https://overpass-turbo.eu  →  ▶ Run  →  Export ▾  →  data → GeoJSON
   שומרים בשם  district_places.geojson  ומחזירים לי.

   למה תיבה ולא מזהה יחס: מזהה של יחס גבול ב-OSM יכול להשתנות, ואז השאילתה
   מחזירה שקט במקום שגיאה. התיבה כאן עוטפת את המחוז כולו; היא בולעת גם שוליים
   של בראגה, אָבֵיירו ווילה ריאל, ו-scripts/ingest_overpass.py מסנן אותם החוצה
   מול פוליגוני CAOP שכבר יש לנו. עדיף לקבל יותר מדי ולסנן מאשר לפספס בשקט.

   מזה נבנית רמה 3 של כל 243 הפרגזיות: כל יישוב מקבל אות (A, B, C…) על המפה
   ורישום מתאים ברשימה — בדיוק כמו 53 השכונות של פורטו היום.
   ========================================================================= */

[out:json][timeout:180][bbox:40.991,-8.799,41.482,-7.866];

(
  nwr["place"~"^(city|town|village|hamlet|suburb|quarter|neighbourhood)$"]["name"];
);

out center;
