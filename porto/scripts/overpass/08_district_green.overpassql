/* ============================================================================
   8 · פארקים, גנים וחופים בכל 18 העיריות
   ----------------------------------------------------------------------------
   שומרים בשם  district_green.geojson  ומחזירים לי.

   השטח כפוליגון, לא כנקודה — כדי שאפשר יהיה לצבוע אותו על המפה ולראות את
   הגודל והצורה. גם כאן out geom, וגם כאן הקובץ יהיה גדול יחסית.

   בכוונה בלי landuse=forest ובלי natural=wood: כל המזרח של המחוז מיוער,
   ופוליגון שמכסה חצי מפה לא אומר כלום. מה שכאן הוא שטח פתוח שמישהו נכנס אליו.
   ========================================================================= */

[out:json][timeout:180][bbox:40.991,-8.799,41.482,-7.866];

(
  way["leisure"~"^(park|garden|nature_reserve)$"]["name"];
  relation["leisure"~"^(park|garden|nature_reserve)$"]["name"];
  way["natural"="beach"]["name"];
);

out geom;
