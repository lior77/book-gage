/* ============================================================================
   9 · הקוד הרשמי של כל אחד מ-243 הרובעים
   ----------------------------------------------------------------------------
   שומרים בשם  freguesia_codes.geojson  ומחזירים לי.

   קוד DICOFRE הוא המזהה הרשמי של יחידה מנהלית בפורטוגל: 13 = מחוז פורטו,
   שתי הספרות הבאות = העירייה, ושתיים אחרונות = הרובע. יש לי כבר את הקוד של
   כל 18 העיריות, אבל של הרובעים יש לי רק 7 מתוך 243 — אלה של עיריית פורטו.
   בלי הקובץ הזה המספור של הרובעים באפליקציה נשאר מספור פנימי ולא רשמי.

   השאילתה מבקשת רק גבולות מנהליים ברמה 8 (רובע) עם התג ref:ine, ולכן היא
   קטנה ומהירה למרות ששטח התיבה גדול. out center — נקודה אחת לכל רובע, בלי
   גיאומטריה; הגבולות כבר יש לי מ-CAOP.
   ========================================================================= */

[out:json][timeout:180][bbox:40.991,-8.799,41.482,-7.866];

relation["boundary"="administrative"]["admin_level"="8"]["ref:ine"];

out center;
