/* ============================================================================
   7 · נהרות ומים בכל 18 העיריות
   ----------------------------------------------------------------------------
   שומרים בשם  district_water.geojson  ומחזירים לי.

   הדואורו, הטמגה, האבה, הסוזה והלסה, ועוד אגמים ומאגרים מתויגים. זו השאילתה
   הראשונה שמחזירה גיאומטריה מלאה (out geom) ולא נקודה אחת לאובייקט, כי קו נהר
   חייב להיות קו. לכן הקובץ יהיה גדול יותר מהקודמים — זה תקין.

   הסינון על waterway ו-natural מאונדקס, והדרישה ל-name מסננת אלפי תעלות
   וערוצי ניקוז חסרי שם שאין להם ערך במפה של המחוז.
   ========================================================================= */

[out:json][timeout:180][bbox:40.991,-8.799,41.482,-7.866];

(
  way["waterway"="river"]["name"];
  way["natural"="water"]["name"];
  relation["natural"="water"]["name"];
);

out geom;
