<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The map background comes from OpenStreetMap over the network; everything
         else is bundled, so the app is fully usable with this permission denied. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- Without this, a photo picked from the gallery arrives with its GPS tags
         zeroed.  Android 10 redacts location from media handed to an app that
         has not asked for it: the GPSInfo block is still there, refs blank and
         every rational 0/0, which reads exactly like a camera that never got a
         fix.  The phone's own gallery shows the address the whole time, because
         it holds this permission — which is what makes the fault so hard to see
         from the outside.  Documented at
         developer.android.com/training/data-storage/shared/media#location-media-captured -->
    <uses-permission android:name="android.permission.ACCESS_MEDIA_LOCATION" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:allowBackup="true"
        android:usesCleartextTraffic="false"
        android:theme="@style/Theme.Porto">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|smallestScreenSize|density"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
